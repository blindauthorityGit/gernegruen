# Development mode: uses bakeryPreorders_dev and the SMTP_DEV_* settings below.
# Set to false in production to use bakeryPreorders and SMTP_*.
BAKERY_PREORDER_DEV=true

# Development SMTP settings
SMTP_DEV_HOST=
SMTP_DEV_PORT=587
SMTP_DEV_USER=
SMTP_DEV_PASSWORD=
SMTP_DEV_FROM="GerneGrün Entwicklung <dev@example.de>"
ORDER_RECIPIENT_DEV=

# Live SMTP settings (used when BAKERY_PREORDER_DEV=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GerneGrün <vorbestellung@example.de>"
ORDER_RECIPIENT=

# Firebase Admin service-account credentials (server only, shared by dev and live)
FIREBASE_PROJECT_ID=
# Public Firebase Web API key (Firebase Console → Project settings → Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the service-account JSON, including BEGIN/END.
# Keep escaped line breaks in .env.local: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Firebase Authentication UIDs allowed to read and edit the Studio dashboard (comma-separated).
# Configure only after enabling a trusted sign-in method and adding the Studio sign-in flow.
FIREBASE_ADMIN_UIDS=

# Optional local-only design preview for "Nächste Woche bei uns".
# Development defaults to enabled when no currently valid Sanity preview exists.
NEXT_WEEK_PREVIEW_DEV=true
# Public origin used for canonical URLs, the sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL="https://gernegruen.de"

